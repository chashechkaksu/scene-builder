{
  "name": "vector-composer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noEmit --force && vite build",
    "preview": "vite preview",
    "library": "tsx scripts/build-library.ts",
    "typecheck": "vue-tsc -b --noEmit --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "snapshot": "tsx scripts/snapshot.ts",
    "examples": "tsx scripts/examples.ts",
    "verify": "npm run library && npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.1.0",
    "canvas-confetti": "^1.9.4",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.48.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tsconfig/node22": "^22.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitest/coverage-v8": "^2.1.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.6"
  }
}
